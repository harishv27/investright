# Copy this file to .env and fill in your own values

# Database: defaults to a local SQLite file if left unset.
# For Postgres, use something like:
# DATABASE_URL=postgresql://user:password@localhost:5432/investright
DATABASE_URL=sqlite:///./investright.db

# Secret used to sign JWT auth tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OAuth 2.0 client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=

# Your Groq API key. Required for the AI Advisor (/api/agent/query) to work.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model used by the agent. Change this to any Groq tool-calling model you have enabled.
GROQ_MODEL=llama-3.3-70b-versatile

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
